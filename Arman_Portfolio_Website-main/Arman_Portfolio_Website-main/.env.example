# ── AI Assistant ─────────────────────────────────────────────
# Google Gemini API Key for the portfolio AI chatbot
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: specify a custom Gemini model
GEMINI_MODEL=gemini-2.5-flash

# ── Contact Form Email Notifications (Gmail) ─────────────────
# Uses a Google "App Password" (not your normal password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Admin Dashboard ──────────────────────────────────────────
# Password for admin.html login (default: milan123)
ADMIN_PASSWORD=milan123

# ── Contact Storage (optional but recommended on Vercel) ─────
# Vercel filesystem is read-only, so configure a Postgres database
# (Vercel Postgres / Neon / Supabase) to persist contact submissions.
# Create a table once:
#   CREATE TABLE contacts (
#     id SERIAL PRIMARY KEY,
#     name TEXT NOT NULL,
#     email TEXT NOT NULL,
#     number TEXT,
#     subject TEXT,
#     message TEXT,
#     timestamp TEXT
#   );
POSTGRES_URL=

# ── SMS Notifications (optional) ─────────────────────────────
SMS_USERNAME=sandbox
SMS_API_KEY=
