{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "i18n.js",
      "use": "@vercel/static"
    },
    {
      "src": "ai-agent-widget.js",
      "use": "@vercel/static"
    },
    {
      "src": "ai-agent-widget.css",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/submit-contact",
      "dest": "/api/contact.js"
    },
    {
      "src": "/api/admin/login",
      "dest": "/api/admin-login.js"
    },
    {
      "src": "/api/admin/contacts",
      "dest": "/api/admin-contacts.js"
    },
    {
      "src": "/api/admin/contacts/delete",
      "dest": "/api/admin-contacts-delete.js"
    },
    {
      "src": "/api/admin/contacts/clear",
      "dest": "/api/admin-contacts-clear.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
